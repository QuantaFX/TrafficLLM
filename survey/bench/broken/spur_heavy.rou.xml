<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic demand for the 9-spur grid: one flow per spur, turning at the first TLS.
     Spurs A0->A1 .. D0->A0 etc. Routes are single-turn so they exist in any spur net. -->
<routes>

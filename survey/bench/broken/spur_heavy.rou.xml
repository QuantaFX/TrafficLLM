  <flow id="w1" type="car" begin="0" end="3600" vehsPerHour="2100" departLane="random" departSpeed="max">
    <route edges="A0A1 A1B1"/>
  </flow>
  <flow id="e1" type="car" begin="0" end="3600" vehsPerHour="2100" departLane="random" departSpeed="max">
    <route edges="C1B1 B1B2"/>
  </flow>
  <flow id="n1" type="car" begin="0" end="3600" vehsPerHour="2100" departLane="random" departSpeed="max">
    <route edges="B2B1 B1A1"/>
  </flow>
  <flow id="s1" type="car" begin="0" end="3600" vehsPerHour="2100" departLane="random" departSpeed="max">
    <route edges="B0B1 B1C1"/>
  </flow>
  <flow id="w2" type="car" begin="0" end="3600" vehsPerHour="1700" departLane="random" departSpeed="max">
    <route edges="A1A2 A2B2"/>
  </flow>
  <flow id="e2" type="car" begin="0" end="3600" vehsPerHour="1700" departLane="random" departSpeed="max">
